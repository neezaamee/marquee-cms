# Enterprise Laravel Exclusions
.env
.env.*
!.env.example
/vendor
/node_modules
npm-debug.log
yarn-error.log
*.log

# Application Specific Caches
/bootstrap/cache/*
!/bootstrap/cache/.gitkeep
/storage/logs/*
!/storage/logs/.gitkeep
/storage/framework/cache/*
!/storage/framework/cache/.gitkeep
/storage/framework/sessions/*
!/storage/framework/sessions/.gitkeep
/storage/framework/views/*
!/storage/framework/views/.gitkeep
/storage/framework/testing/*
!/storage/framework/testing/.gitkeep
/storage/*.key
/storage/pail
/public/storage
/public/build
/public/hot
/public/fonts-manifest.dev.json

# Local Databases & Dumps
*.sqlite
database/*.sqlite
database/*.sql
*.sql.gz

# Testing cache & Scratch artifacts
.phpunit.result.cache
/.phpunit.cache
scratch*.txt
*.tmp
*.bak

# IDE, Editor and OS System Configurations
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini
Homestead.json
Homestead.yaml
_ide_helper.php
_ide_helper_models.php
.phpstorm.meta.php
/composer.phar
/auth.json
/.codex
/.cursor/
/.nova
/.zed

