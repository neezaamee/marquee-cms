# Enterprise Laravel Exclusions
.env
.env.*
!.env.example
/vendor
vendor/
/node_modules
node_modules/
npm-debug.log
yarn-error.log
yarn-debug.log*
*.log

# Application Specific Caches & Generated Runtime Files
/bootstrap/cache/*
!/bootstrap/cache/.gitignore
!/bootstrap/cache/.gitkeep
/storage/logs/*
!/storage/logs/.gitignore
!/storage/logs/.gitkeep
/storage/framework/cache/*
!/storage/framework/cache/.gitignore
!/storage/framework/cache/.gitkeep
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
!/storage/framework/sessions/.gitkeep
/storage/framework/views/*
!/storage/framework/views/.gitignore
!/storage/framework/views/.gitkeep
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
!/storage/framework/testing/.gitkeep
/storage/*.key
/storage/pail
/public/storage
/public/build
/public/hot
/public/fonts-manifest.dev.json

# Local Databases, SQLite & SQL Dumps
*.sqlite
*.sqlite3
*.db
database/*.sqlite
database/*.sqlite3
database/*.sql
*.sql
*.sql.gz

# Testing Cache, Coverage & Scratch Artifacts
.phpunit.result.cache
/.phpunit.cache
scratch*.txt
*.tmp
*.bak

# Local Notes, AI Walkthrough & Review Artifacts (Do not commit)
McmsPR
McmsPR.*
WalkthroughPR
WalkthroughPR.*
*_walkthrough.md
*_PR.md

# IDE, Editor and OS System Configurations
.idea/
.vscode/
.fleet/
.run/
.sublime-*
*.swp
*.swo
*~
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
Homestead.json
Homestead.yaml
_ide_helper.php
_ide_helper_models.php
.phpstorm.meta.php
/composer.phar
/auth.json
/.codex
/.cursor/
/.nova
/.zed
